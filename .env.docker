# Art-OS Environment Configuration
# Copy this file to .env and fill in your values

# Database Passwords
POSTGRES_PASSWORD=artbank_secure_password_change_me
NEO4J_PASSWORD=neo4j_secure_password_change_me

# RabbitMQ Credentials
RABBITMQ_USER=artbank
RABBITMQ_PASS=rabbitmq_secure_password_change_me

# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET=your-256-bit-secret-change-me-in-production

# Grafana (optional, for monitoring profile)
GRAFANA_PASSWORD=admin
